# Copie este arquivo para .streamlit/secrets.toml e preencha os valores.
# O secrets.toml real está no .gitignore — NUNCA o envie junto com o projeto.
# Todos os campos são opcionais: sem eles o painel roda em modo local (Excel) e sem IA.

# NVIDIA NIM (Nemotron) — https://build.nvidia.com → "Get API Key". Começa com nvapi-
NVIDIA_API_KEY = ""

# Supabase — Project Settings → Data API (URL) e Project Settings → API Keys (chave secreta).
# Use a chave SECRETA (sb_secret_...), nunca a publicável (sb_publishable_...).
SUPABASE_URL = ""          # ex.: https://abcdefghijklmnopqrst.supabase.co
SUPABASE_SECRET_KEY = ""   # ex.: sb_secret_...
